# App role: row-level security applies.
DATABASE_URL=postgres://kleidi_app:kleidi_app@localhost:5434/kleidi
# Owner role: migrations and seeding only.
DATABASE_ADMIN_URL=postgres://kleidi_admin:kleidi_admin@localhost:5434/kleidi

API_PORT=4100
# Signs sessions. Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-chars
WEB_ORIGIN=http://localhost:5180

S3_ENDPOINT=http://localhost:8333
S3_REGION=fr-par
S3_BUCKET=kleidi-documents
S3_ACCESS_KEY=kleidi
S3_SECRET_KEY=kleidi-dev-secret

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Kleidi <no-reply@kleidi.local>
